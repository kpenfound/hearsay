# The environment for the systemd units in deploy/systemd. Copy it to
# ~/.config/hearsay/hearsay.env, fill in every empty value, and keep it private
# (chmod 600): it holds the database password and every API token. Every unit
# reads the whole file, because the variables a configuration names (token_env,
# secrets, api_key_env) are its own choice. docs/deploy.md has the whole table.
#
# Values are KEY=value, one per line, unquoted unless the value needs it.

# --- Database ---------------------------------------------------------------

# migrate and all four services: the database, Postgres 16 or later with
# pgvector. Must be supplied. For Neon, use the DIRECT endpoint (the host
# without "-pooler"): the job queue holds LISTEN connections and migrations
# take a session advisory lock, which a transaction-mode pooler breaks.
#   postgres://<role>:<password>@ep-<name>.<region>.aws.neon.tech/<db>?sslmode=require
HEARSAY_DATABASE_URL=

# --- Listen addresses -------------------------------------------------------

# Every service listens on the host itself, so bind them to loopback and put
# whatever serves them publicly (the webhooks) in front: `tailscale funnel` for
# /hooks, `tailscale serve` for the API on the tailnet. docs/deploy.md.
HEARSAY_API_LISTEN=127.0.0.1:8080
HEARSAY_LISTEN=127.0.0.1:8081
HEARSAY_DISTILLER_LISTEN=127.0.0.1:8082
HEARSAY_ASSERT_WORKER_LISTEN=127.0.0.1:8083

# api: also serve the API on the tailnet, through an embedded Tailscale node,
# at https://<this name>.<tailnet>.ts.net (HTTPS when the tailnet issues
# certificates, plain HTTP on port 80 otherwise). Agents on other machines use
# that URL; the loopback listener above stays. Empty serves only loopback. The
# unit keeps the node's state in ~/.local/state/hearsay/tailnet.
HEARSAY_API_TAILNET=hearsay
# api: the node's first login. Without it the API logs a login URL to approve;
# later starts use the saved state, so it can be removed after the first.
# TS_AUTHKEY=
# api: serve plain HTTP on the tailnet's port 80 instead of HTTPS on 443.
# HEARSAY_API_TAILNET_HTTP=true

# all four services: optional logging overrides. JSON is the default without a
# terminal, and the journal keeps it.
# HEARSAY_LOG_LEVEL=info
# HEARSAY_LOG_FORMAT=json

# distiller: optional per-document debounce (Go durations; quiet 0 disables).
# HEARSAY_DISTILL_QUIET=30s
# HEARSAY_DISTILL_MAX_DELAY=5m

# --- API tokens -------------------------------------------------------------

# One per human and agent the configuration names in `token_env`: a random,
# distinct value each (`openssl rand -hex 32`). `hearsay init` generates them.
# api reads every one and refuses to start if one is empty or two are equal;
# connectors reads the agents' tokens for an `agent` source and permitted
# posters' tokens for a `work` source. These are the names config/hearsay.yaml
# uses; yours are your configuration's.
HEARSAY_OPERATOR_TOKEN=
HEARSAY_ASSISTANT_TOKEN=

# --- Models -----------------------------------------------------------------

# The distill and assert tiers use claude-sbx: the owner's Claude Code login,
# stored with `sbx secret set`, in a Docker Sandbox per call. No model key is
# read for them.

# distiller, assert-worker: Jev, through OpenRouter (llm.judgments, whose
# api_key_env names this variable). Both decide from its answers and refuse to
# start without it.
OPENROUTER_API_KEY=

# --- Source credentials -----------------------------------------------------

# Only the ones your configuration's `secrets:` name are read, under the names
# it gives them; these are the names `hearsay init` writes. The example
# configuration names none of them.

# connectors; assert-worker too, for a GitHub source that is not read_only or
# that code/ names.
HEARSAY_GITHUB_TOKEN=

# connectors: the secret the repositories' webhooks sign deliveries with.
HEARSAY_GITHUB_WEBHOOK_SECRET=

# connectors: a Drive service account's JSON key, on one line, in single quotes.
HEARSAY_DRIVE_CREDENTIALS=
