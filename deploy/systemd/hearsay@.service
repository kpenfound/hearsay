# One Hearsay service as a systemd user unit: the instance is the subcommand,
# one of api, connectors, distiller or assert-worker. hearsay.target starts all
# four. docs/deploy.md ("On one host with systemd") is the guide.
#
#   install -D -m 0644 -t ~/.config/systemd/user deploy/systemd/*.service deploy/systemd/hearsay.target
#   systemctl --user daemon-reload
#   systemctl --user enable --now hearsay.target
#   loginctl enable-linger "$USER"   # start at boot without a login session
#
# It is a user unit, not a system one, because the claude-sbx provider runs
# each model call in a Docker Sandbox with the owner's stored Claude Code
# login: the process needs the owner's sbx daemon and Docker access. The unit
# therefore names no account and carries no sandboxing directives of its own;
# the sandbox per call is what keeps ingested text away from the owner's files.
#
# Read the logs (JSON lines, collected by the user journal):
#   journalctl --user -u 'hearsay@*' -o cat | jq .

[Unit]
Description=Hearsay %i
Documentation=https://github.com/kpenfound/hearsay/blob/main/docs/deploy.md
PartOf=hearsay.target
# The schema is migrated by its own job before any service starts, never by a
# service. A failed migration fails the start.
Requires=hearsay-migrate.service
After=hearsay-migrate.service network.target

[Service]
Type=exec
ExecStart=%h/.local/bin/hearsay %i

# Secrets and the deployment's settings, one KEY=value per line, mode 0600:
# the database URL, the API tokens, the OpenRouter key and the source
# credentials. env.example lists every one.
EnvironmentFile=%h/.config/hearsay/hearsay.env
# The configuration repository: one hearsay.yaml or the directory form.
Environment=HEARSAY_CONFIG=%h/.config/hearsay/config
# Where the API's tailnet node keeps its state, when HEARSAY_API_TAILNET names
# one (~/.local/state/hearsay/tailnet). Only the API reads it.
StateDirectory=hearsay
Environment=HEARSAY_API_TAILNET_DIR=%S/hearsay/tailnet

# User units get a minimal PATH. sbx and docker must be on it for claude-sbx.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

# A service refuses to start when its database or configuration is wrong, and
# exits when its database goes away; retry rather than give up.
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=hearsay.target
