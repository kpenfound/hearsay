# The deploy job: `hearsay migrate up`, run before any Hearsay service starts,
# and again whenever one starts, where it applies what is pending and otherwise
# does nothing. No service migrates for itself. docs/deploy.md is the guide.

[Unit]
Description=Hearsay schema migrations
Documentation=https://github.com/kpenfound/hearsay/blob/main/docs/deploy.md
After=network.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/hearsay migrate up
# Reads only HEARSAY_DATABASE_URL from it.
EnvironmentFile=%h/.config/hearsay/hearsay.env
# A long migration on a remote database, and a cold start of a database that
# suspends when idle.
TimeoutStartSec=600
