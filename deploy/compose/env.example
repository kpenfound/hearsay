# The environment for deploy/compose/compose.yaml. Copy it to `.env` beside
# compose.yaml, fill in every empty value, and keep `.env` out of version
# control (chmod 600 .env): it holds the database password and every API token.
#
# Compose reads `.env` twice: to fill in ${...} in compose.yaml (HEARSAY_IMAGE,
# POSTGRES_PASSWORD, HEARSAY_DATABASE_URL), and as the env_file of the four
# Hearsay services. Postgres gets only its password and the migration job only
# the database URL.
#
# Nothing here is a working secret. An empty value must be supplied; a value
# that is filled in is an example to change. Each entry says which service
# reads it. docs/deploy.md has the whole table.
#
# Values are KEY=value, one per line. Compose expands $ in an unquoted value, so
# put a value that contains $ in single quotes.

# --- Deployment -------------------------------------------------------------

# Compose: the image all five Hearsay containers run. Pick a published version
# tag; there is no `latest`. Example value.
HEARSAY_IMAGE=ghcr.io/kpenfound/hearsay:v0.10.0

# postgres: the password it creates the `hearsay` role with, on first start
# only. Must be supplied (`openssl rand -hex 32`). Changing it later does not
# change the role's password; that is an ALTER ROLE.
POSTGRES_PASSWORD=

# migrate, connectors, distiller, assert-worker, api: the database. Must be
# supplied, in this form, with POSTGRES_PASSWORD in place of <password>
# (percent-encoded if it has characters a URL reserves):
#   postgres://hearsay:<password>@postgres:5432/hearsay?sslmode=disable
# `postgres` is the compose service's hostname. sslmode=disable is safe only
# because the connection never leaves the compose network.
HEARSAY_DATABASE_URL=

# connectors, distiller, assert-worker, api: optional logging overrides.
# HEARSAY_LOG_LEVEL=info
# HEARSAY_LOG_FORMAT=json

# --- API tokens -------------------------------------------------------------

# One per human and agent the configuration names in `token_env`: a random,
# distinct value each (`openssl rand -hex 32`). `hearsay init` generates them.
# api reads every one and refuses to start if one is empty or two are equal;
# connectors reads the agents' tokens when an `agent` source is configured.
# These two are the names config/hearsay.yaml uses. Must be supplied.
HEARSAY_OPERATOR_TOKEN=
HEARSAY_ASSISTANT_TOKEN=

# --- Model provider ---------------------------------------------------------

# distiller, assert-worker, api: the credential of the model tiers
# (docs/config.md, `llm/`). Every one of them builds the tiers at startup and
# refuses without it. Must be supplied.
ANTHROPIC_API_KEY=

# --- Source credentials -----------------------------------------------------

# Only the ones your configuration's `secrets:` name are read, under the names it
# gives them; these are the names `hearsay init` writes (Slack's are the ones
# docs/config.md uses, until `hearsay init` knows Slack). The example
# configuration names none of them, so they may stay empty with it.

# connectors; assert-worker too, for a GitHub source that is not read_only or
# that code/ names. A token for the configured repositories.
HEARSAY_GITHUB_TOKEN=

# connectors: the secret the repositories' webhooks sign deliveries with.
HEARSAY_GITHUB_WEBHOOK_SECRET=

# connectors; api too, for a Discord source that names application_id and
# public_key and is not read_only. The bot token.
HEARSAY_DISCORD_TOKEN=

# connectors: a Slack app's app-level token (xapp-…), which opens Socket Mode,
# and its bot token (xoxb-…), which reads the channels.
HEARSAY_SLACK_APP_TOKEN=
HEARSAY_SLACK_BOT_TOKEN=

# connectors: a Drive service account's JSON key, on one line, in single quotes.
HEARSAY_DRIVE_CREDENTIALS=
