"""
Hearsay's own Dagger module: the binary, the container image, migrations, the
local dev stack, and the checks the reusable Go module does not cover.

The tests and the generate drift check are the Go module's (github.com/dagger/go,
installed in dagger.toml). Everything here is what that module could not know
about Hearsay.
"""
type Hearsay {
  """
  The repository, as every command here sees it.

  .dagger is excluded because nothing here builds it, and including it would
  invalidate every cached step on each edit to a module.
  """
  source(ws: Workspace!): Directory! {
    ws.directory("/", exclude: [".git", ".bees", ".dagger", "dist", "hearsay"])
  }

  """
  The Go release go.mod asks for.

  Read rather than pinned, so the floor moves in go.mod and nothing here has to
  be edited to follow (ADR-0010). dagger.lock is the exception: it records the
  resolved digest of golang:<this version>, and a raise leaves it pinning the
  release the floor moved off until someone re-pins it. CONTRIBUTING.md's
  "Raising the Go floor" has the procedure.
  """
  goVersion(ws: Workspace!): String! {
    let goMod = ws.directory("/", include: ["go.mod"]).file("go.mod").contents
    let directive = goMod.match(`(?m)^go\s+(\d+\.\d+(?:\.\d+)?)\s*$`)
    if (directive == null) {
      raise "go.mod has no go directive"
    } else {
      directive.captures[0]!
    }
  }

  """
  The base container the reusable Go module receives for its tests. Keep it
  here so the Go version and Postgres match the rest of Hearsay's checks. The
  Go module adds the source, working directory and caches; it expects Alpine
  because it builds its helper binaries there.
  """
  goTestBase(ws: Workspace!): Container! {
    container
      .from("golang:" + goVersion(ws) + "-alpine")
      .withServiceBinding("postgres", postgres)
      .withEnvVariable("HEARSAY_DATABASE_URL", databaseUrl)
  }

  """
  The container every Go command runs in: the toolchain go.mod asks for, the
  caches, and the source at /src.
  """
  goBase(ws: Workspace!): Container! {
    withGoCaches(container.from("golang:" + goVersion(ws)))
      .withMountedDirectory("/src", source(ws))
      .withWorkdir("/src")
  }

  """
  golangci-lint's own image, sharing the Go caches so that the toolchain it
  fetches is fetched once.

  The version is the one CONTRIBUTING.md tells a contributor to match. The
  image carries a Go toolchain of its own, which may be older than the one
  go.mod asks for; GOTOOLCHAIN=auto fetches the right one into the shared
  module cache. The linter binary itself must be built with a Go release at
  least as new as go.mod's, or it refuses to load the config — the reason the
  Go module's own lint check is switched off in dagger.toml.
  """
  let lintBase(ws: Workspace!): Container! {
    withGoCaches(container.from("golangci/golangci-lint:v2.13.2"))
      .withEnvVariable("GOLANGCI_LINT_CACHE", "/cache/golangci-lint")
      .withMountedCache("/cache/golangci-lint", cacheVolume("hearsay-golangci-lint"))
      .withMountedDirectory("/src", source(ws))
      .withWorkdir("/src")
  }

  let withGoCaches(ctr: Container!): Container! {
    ctr
      .withEnvVariable("GOPATH", "/go")
      .withEnvVariable("GOCACHE", "/cache/go-build")
      .withEnvVariable("GOTOOLCHAIN", "auto")
      .withMountedCache("/go/pkg/mod", cacheVolume("hearsay-go-mod"))
      .withMountedCache("/cache/go-build", cacheVolume("hearsay-go-build"))
  }

  """
  Lint the module: go vet, golangci-lint and the formatter check.

  Formatting is part of the lint gate, not a separate ritual: `fmt --diff`
  prints what `golangci-lint fmt` would change and fails if there is anything.
  """
  lint(ws: Workspace!): Void @check {
    # A record evaluates its fields concurrently, so vet and the linter run in
    # parallel and the check fails on whichever finishes first with an error.
    {{
      vet: goBase(ws).withExec(["go", "vet", "./..."]).sync,
      golangci: lintBase(ws)
        .withExec(["golangci-lint", "run"])
        .withExec(["golangci-lint", "fmt", "--diff"])
        .sync,
    }}
    null
  }

  """
  Runs the tests tagged `integration` against a real Postgres with pgvector.

  ADR-0006 puts `hearsay migrate up` between the database and the tests, so
  that a missing migration fails the check rather than being papered over by a
  fixture. It runs from the code under test, and it is also what proves the
  image is the pgvector build: migration 1 creates the extension, and stock
  Postgres fails there — the mistake ADR-0004 warns about.

  Migrating and testing are one exec. As two, a rerun after a failed test
  reuses the cached migrate step while the service starts a fresh, empty
  Postgres, and every test then finds a database at version 0.

  The Go module's own test check runs the untagged tests; these carry the tag
  so that a plain `go test ./...` skips them on a machine with no Postgres.
  """
  integrationTest(ws: Workspace!): Void @check {
    goBase(ws)
      .withServiceBinding("postgres", postgres)
      .withEnvVariable("HEARSAY_DATABASE_URL", databaseUrl)
      .withExec(["sh", "-c", "go run ./cmd/hearsay migrate up && go test -race -tags=integration ./..."])
      .sync
    null
  }

  """
  Fails if `go mod tidy` would change go.mod or go.sum.
  """
  tidyCheck(ws: Workspace!): Void @check {
    goBase(ws)
      .withExec(["sh", "-c", """
        set -e
        cp go.mod /tmp/go.mod.before
        cp go.sum /tmp/go.sum.before
        go mod tidy
        diff -u /tmp/go.mod.before go.mod
        diff -u /tmp/go.sum.before go.sum
      """])
      .sync
    null
  }

  """
  Builds the default image and both release platforms, and checks the stamped
  version and publish address without pushing to a registry.
  """
  imageCheck(ws: Workspace!): Void @check {
    image(ws).sync
    # Exercise the same two platform builds and version stamp publish uses,
    # without credentials or a registry write.
    let version = "v0.0.0-image-check"
    if (publishAddress(version, "ghcr.io/kpenfound/hearsay") != "ghcr.io/kpenfound/hearsay:" + version) {
      raise "publish address does not use the stamped version"
    }
    let amd64 = image(ws, version: version, platform: "linux/amd64")
    let arm64 = image(ws, version: version, platform: "linux/arm64")
    if (amd64.platform != "linux/amd64" or arm64.platform != "linux/arm64") {
      raise "image platforms do not match the publish manifest"
    }
    if (amd64.withExec(["version"], useEntrypoint: true).stdout.match(`^hearsay v0\.0\.0-image-check `) == null or
        arm64.withExec(["version"], useEntrypoint: true).stdout.match(`^hearsay v0\.0\.0-image-check `) == null) {
      raise "image version does not match the publish tag"
    }
    null
  }

  """
  The hearsay binary, compiled for Linux on the selected architecture.
  Static (CGO_ENABLED=0), so the runtime image only has to supply certificates
  and timezones.
  """
  build(
    ws: Workspace!,
    """
    Version to stamp into the binary. Empty means what internal/version works
    out for itself.
    """
    version: String! = "",
    """Target platform; defaults to the engine's platform."""
    platform: Platform,
  ): File! {
    let ldflags = if (version == "") {
      "-s -w"
    } else {
      "-s -w -X github.com/kpenfound/hearsay/internal/version.version=" + version
    }
    let base = if (platform == null) { goBase(ws) } else {
      withGoCaches(container(platform: platform).from("golang:" + goVersion(ws)))
        .withMountedDirectory("/src", source(ws))
        .withWorkdir("/src")
    }
    base
      .withEnvVariable("CGO_ENABLED", "0")
      .withEnvVariable("GOOS", "linux")
      # go build does not create the directory it is told to write into.
      .withDirectory("/out", directory)
      .withExec(["go", "build", "-trimpath", "-ldflags", ldflags, "-o", "/out/hearsay", "./cmd/hearsay"])
      .file("/out/hearsay")
  }

  """
  The container image hearsay ships in. One image runs all four services; the
  subcommand is the argument (ADR-0003).
  """
  image(
    ws: Workspace!,
    """
    Version to stamp into the binary.
    """
    version: String! = "",
    """Target platform; defaults to the engine's platform."""
    platform: Platform,
  ): Container! {
    let base = if (platform == null) { container } else { container(platform: platform) }
    base
      .from("alpine:3.22")
      .withExec(["apk", "add", "--no-cache", "ca-certificates", "tzdata"])
      .withFile("/usr/local/bin/hearsay", build(ws, version: version, platform: platform))
      .withUser("nobody")
      .withEntrypoint(["/usr/local/bin/hearsay"])
      # The base image's CMD would otherwise be handed to hearsay as a
      # subcommand. With no default the image prints its usage and exits
      # non-zero, which is the right answer to "run hearsay" with no service.
      .withoutDefaultArgs
  }

  """
  Publish one linux/amd64 and linux/arm64 image manifest. Run deliberately at
  release time; this function is not a check.
  """
  publish(
    ws: Workspace!,
    """Version stamped into both binaries and used as the image tag."""
    version: String!,
    """Registry username with permission to push the image."""
    username: String!,
    """Registry token or password."""
    password: Secret!,
    """Untagged image address, for example ghcr.io/my-org/hearsay."""
    imageAddress: String! = "ghcr.io/kpenfound/hearsay",
  ): String! {
    let address = publishAddress(version, imageAddress)
    if (username == "") { raise "registry username is required" }
    image(ws, version: version, platform: "linux/amd64")
      .withRegistryAuth(imageAddress, username, password)
      .publish(address, platformVariants: [image(ws, version: version, platform: "linux/arm64")])
  }

  let publishAddress(version: String!, imageAddress: String!): String! {
    if (version.match(`^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$`) == null) {
      raise "version must be a nonempty OCI image tag"
    }
    if (imageAddress == "") { raise "image address is required" }
    imageAddress + ":" + version
  }

  """
  The throwaway Postgres the tests and the dev stack run against.

  The pgvector build, not stock Postgres: ADR-0004 puts the embedding column on
  the L1 table, so a plain server fails on the first migration. Postgres 16 is
  the minimum that ADR sets. The credentials are a local throwaway's and the
  same everywhere.
  """
  postgres: Service! {
    container
      .from("pgvector/pgvector:pg16")
      .withEnvVariable("POSTGRES_USER", "hearsay")
      .withEnvVariable("POSTGRES_PASSWORD", "hearsay")
      .withEnvVariable("POSTGRES_DB", "hearsay")
      .withExposedPort(5432)
      .asService(useEntrypoint: true)
  }

  """
  The connection URL for that Postgres, reachable under the service binding
  alias `postgres`. The binary reads it from HEARSAY_DATABASE_URL.
  """
  databaseUrl: String! = "postgres://hearsay:hearsay@postgres:5432/hearsay?sslmode=disable"

  """
  Applies the schema migrations to a database (ADR-0006), as a job from the
  image that is being deployed rather than a container of its own.
  """
  migrate(
    ws: Workspace!,
    """
    Postgres connection URL, for example
    postgres://hearsay:hearsay@localhost:5432/hearsay.
    """
    databaseUrl: Secret!,
    """
    up, status, up-to or down.
    """
    action: String! = "up",
    """
    The target version, for up-to.
    """
    arg: String! = "",
  ): String! {
    image(ws)
      .withSecretVariable("HEARSAY_DATABASE_URL", databaseUrl)
      .withExec(["migrate", action] + (if (arg == "") { [] :: [String!]! } else { [arg] }), useEntrypoint: true)
      .stdout
  }

  """
  The image with its runtime dependencies attached: Postgres bound as a service
  and HEARSAY_DATABASE_URL pointing at it. Everything that runs the binary for
  development builds on this.
  """
  let runtime(ws: Workspace!): Container! {
    image(ws)
      .withServiceBinding("postgres", postgres)
      .withEnvVariable("HEARSAY_DATABASE_URL", databaseUrl)
  }

  """
  The runtime plus what a person or a test plan poking at it needs: root, so
  `apk add` works for whatever the session turns out to need, and psql already
  pointed at the database.
  """
  let sandbox(ws: Workspace!): Container! {
    runtime(ws)
      .withUser("root")
      .withExec(["apk", "add", "--no-cache", "postgresql16-client"])
      .withEnvVariable("PGHOST", "postgres")
      .withEnvVariable("PGUSER", "hearsay")
      .withEnvVariable("PGPASSWORD", "hearsay")
      .withEnvVariable("PGDATABASE", "hearsay")
  }

  """
  An interactive shell in an isolated copy of the runtime: the image hearsay
  ships in, the binary on PATH, Postgres running beside it, and both
  HEARSAY_DATABASE_URL and psql pointed at it. Changes are live: it is built
  from the working tree, and the rebuild is a cached one.

      dagger api call hearsay playground
  """
  playground(ws: Workspace!): Container! {
    sandbox(ws).terminal
  }

  """
  Runs a test plan in the same environment as `playground`, without a terminal.
  The script is written to /test.sh and run with sh; the result is its combined
  stdout and stderr, followed by its exit code. The exit code is reported rather
  than raised, so a failing plan still returns its transcript.

      dagger api call hearsay qa --script 'hearsay version; psql -c "select 1"'
  """
  qa(
    ws: Workspace!,
    """
    The shell script to run, as the contents of /test.sh.
    """
    script: String!,
  ): String! {
    sandbox(ws)
      .withNewFile("/test.sh", script)
      .withExec(["sh", "-c", "sh /test.sh 2>&1; echo \"exit code: $?\""])
      .stdout
  }

  """
  The production compose deployment in deploy/compose, as docs/deploy.md
  describes it.
  """
  let composeDir(ws: Workspace!): Directory! {
    ws.directory("/deploy/compose")
  }

  """
  The Docker CLI with the compose plugin, and jq to read what compose prints.
  """
  let composeCli: Container! {
    container
      .from("docker:28-cli")
      .withExec(["apk", "add", "--no-cache", "jq"])
  }

  """
  Checks deploy/compose without a Docker daemon.

  Compose parses compose.yaml against env.example with its empty values filled
  in, and the result it prints is held to the production shape: Postgres on a
  named volume, the migration job, the four services each waiting on both and
  mounting the configuration read-only, and nothing published but the API and
  the connectors, on loopback. env.example has to name every variable
  compose.yaml or the example configuration reads, and the image has to accept
  that configuration.
  """
  composeCheck(ws: Workspace!): Void @check {
    {{
      compose: composeCli
        .withDirectory("/deploy", composeDir(ws))
        .withWorkdir("/deploy")
        .withExec(["sh", "-c", """
          set -eu
          # Every variable compose.yaml interpolates, and every one the example
          # configuration names, is an entry in env.example.
          missing=""
          for v in $( { grep -oE '[$][{][A-Z0-9_]+' compose.yaml | cut -c3-; grep -rhoE 'HEARSAY_[A-Z0-9_]+' config; } | sort -u); do
            grep -qE "^$v=" env.example || missing="$missing $v"
          done
          if [ -n "$missing" ]; then echo "env.example does not name:$missing"; exit 1; fi

          # What an operator writes: env.example with every blank filled in.
          sed -E 's/^([A-Z0-9_]+)=$/\1=example-value/' env.example > .env
          image=$(grep -E '^HEARSAY_IMAGE=' .env | cut -d= -f2-)
          docker compose config --format json > /tmp/compose.json
          jq -r --arg img "$image" -f /dev/stdin /tmp/compose.json > /tmp/failures <<'JQ'
          . as $c
          | {"connectors": "8081", "distiller": "8082", "assert-worker": "8083", "api": "8080"} as $port
          | [
            (if ($c.services | keys) != ["api", "assert-worker", "connectors", "distiller", "migrate", "postgres"]
              then "services are " + ($c.services | keys | join(", ")) + "; want postgres, migrate, connectors, distiller, assert-worker and api" else empty end),
            ([$c.services | to_entries[] | .key as $k | (.value.ports // [])[] | $k + " " + (.host_ip // "") + ":" + (.published | tostring) + ":" + (.target | tostring)] | sort) as $pub
            | (if $pub != ["api 127.0.0.1:8080:8080", "connectors 127.0.0.1:8081:8081"]
              then "published ports are [" + ($pub | join(", ")) + "]; want only the API's 8080 and the connectors' 8081, on loopback" else empty end),
            ($c.services.postgres as $p
              | (if ($p.image | test("^pgvector/pgvector:pg(1[6-9]|[2-9][0-9])")) | not then "postgres: " + $p.image + " is not pgvector on Postgres 16 or later" else empty end),
                (if ([$p.volumes[]? | select(.type == "volume" and .source == "pgdata" and .target == "/var/lib/postgresql/data")] | length) != 1 then "postgres: its data is not on the named volume pgdata" else empty end),
                (if ($p.environment | keys) != ["POSTGRES_DB", "POSTGRES_PASSWORD", "POSTGRES_USER"] then "postgres: sees " + ($p.environment | keys | join(", ")) + "; want only its own settings" else empty end),
                (if $p.healthcheck.test == null then "postgres: no healthcheck" else empty end)),
            ($c.services.migrate as $m
              | (if $m.command != ["migrate", "up"] then "migrate: command is not migrate up" else empty end),
                (if $m.image != $img then "migrate: image is not HEARSAY_IMAGE" else empty end),
                (if $m.depends_on.postgres.condition != "service_healthy" then "migrate: does not wait for a healthy postgres" else empty end),
                (if ($m.environment | keys) != ["HEARSAY_DATABASE_URL"] then "migrate: sees " + ($m.environment | keys | join(", ")) + "; want only HEARSAY_DATABASE_URL" else empty end),
                (if ($m.restart // "no") != "no" then "migrate: restarts; it is a job" else empty end)),
            ($port | keys[] as $n | $c.services[$n] as $s
              | (if $s.command != [$n] then $n + ": command is not " + $n else empty end),
                (if $s.image != $img then $n + ": image is not HEARSAY_IMAGE" else empty end),
                (if $s.depends_on.postgres.condition != "service_healthy" then $n + ": does not wait for a healthy postgres" else empty end),
                (if $s.depends_on.migrate.condition != "service_completed_successfully" then $n + ": does not wait for the migration job to succeed" else empty end),
                (if $s.environment.HEARSAY_CONFIG != "/etc/hearsay" then $n + ": HEARSAY_CONFIG is not /etc/hearsay" else empty end),
                (if ([$s.volumes[]? | select(.target == "/etc/hearsay" and .read_only == true)] | length) != 1 then $n + ": the configuration is not mounted read-only at /etc/hearsay" else empty end),
                (if ($s.environment.HEARSAY_DATABASE_URL // "") == "" then $n + ": does not read HEARSAY_DATABASE_URL from .env" else empty end),
                (if ($s.healthcheck.test // [] | join(" ")) != ("CMD wget -q -O /dev/null http://127.0.0.1:" + $port[$n] + "/readyz") then $n + ": healthcheck is not its own /readyz" else empty end))
          ] | .[]
          JQ
          if [ -s /tmp/failures ]; then cat /tmp/failures; exit 1; fi
        """])
        .sync,
      config: image(ws)
        .withDirectory("/etc/hearsay", composeDir(ws).directory("config"))
        .withExec(["config", "validate", "/etc/hearsay"], useEntrypoint: true)
        .sync,
    }}
    null
  }

  """
  Runs deploy/compose for real, in a Docker daemon of its own, and checks that
  the migration job succeeds, all four services report healthy, and only the
  API and the connectors are published. The image is the one built from the
  working tree; env.example is filled in with generated secrets. Returns the
  transcript, and fails if any of that does not hold.

  Not a check: the daemon needs a privileged container.

      dagger api call hearsay compose-smoke
  """
  composeSmoke(ws: Workspace!): String! {
    # Compose asks the daemon to bind-mount ./config, and the daemon resolves
    # that path on its own filesystem, so the daemon has the directory too.
    let dockerd = container
      .from("docker:28-dind")
      .withEnvVariable("DOCKER_TLS_CERTDIR", "")
      .withDirectory("/deploy", composeDir(ws))
      .withExposedPort(2375)
      .asService(useEntrypoint: true, insecureRootCapabilities: true)
    composeCli
      .withServiceBinding("docker", dockerd)
      .withEnvVariable("DOCKER_HOST", "tcp://docker:2375")
      .withFile("/images/hearsay.tar", image(ws).asTarball)
      .withFile("/images/postgres.tar", container.from("pgvector/pgvector:pg16").asTarball)
      .withDirectory("/deploy", composeDir(ws))
      .withWorkdir("/deploy")
      .withExec(["sh", "-c", """
        set -eu
        i=0
        until docker info >/dev/null 2>&1; do
          i=$((i + 1)); [ "$i" -lt 60 ] || { echo "the Docker daemon did not start"; exit 1; }
          sleep 1
        done
        # Both images come from Dagger, so the daemon pulls nothing.
        docker tag "$(docker load -q -i /images/hearsay.tar | awk '{print $NF}')" hearsay:compose-smoke
        docker tag "$(docker load -q -i /images/postgres.tar | awk '{print $NF}')" pgvector/pgvector:pg16

        secret() { head -c 32 /dev/urandom | od -An -tx1 | tr -d ' ' | tr -d '[:space:]'; }
        password=$(secret)
        operator=$(secret)
        sed -E \
          -e "s|^HEARSAY_IMAGE=.*|HEARSAY_IMAGE=hearsay:compose-smoke|" \
          -e "s|^POSTGRES_PASSWORD=$|POSTGRES_PASSWORD=$password|" \
          -e "s|^HEARSAY_DATABASE_URL=$|HEARSAY_DATABASE_URL=postgres://hearsay:$password@postgres:5432/hearsay?sslmode=disable|" \
          -e "s|^HEARSAY_OPERATOR_TOKEN=$|HEARSAY_OPERATOR_TOKEN=$operator|" \
          -e "s|^HEARSAY_ASSISTANT_TOKEN=$|HEARSAY_ASSISTANT_TOKEN=$(secret)|" \
          -e "s|^ANTHROPIC_API_KEY=$|ANTHROPIC_API_KEY=not-a-real-key|" \
          env.example > .env

        if ! docker compose up -d --wait --wait-timeout 180; then
          docker compose ps -a
          docker compose logs --no-color
          exit 1
        fi
        docker compose ps -a --format '{{.Service}}	{{.State}}	{{.Health}}	{{.ExitCode}}	{{.Publishers}}'

        fail=0
        [ "$(docker compose ps -a migrate --format '{{.State}} {{.ExitCode}}')" = "exited 0" ] || { echo "FAIL: migrate did not exit 0"; fail=1; }
        for s in connectors distiller assert-worker api; do
          [ "$(docker compose ps $s --format '{{.Health}}')" = "healthy" ] || { echo "FAIL: $s is not healthy"; fail=1; }
        done
        published=$(docker compose ps -a --format json | jq -rs '[.[] | .Service as $s | (.Publishers // [])[] | select(.PublishedPort > 0) | "\($s) \(.URL):\(.PublishedPort)->\(.TargetPort)"] | sort | join(", ")')
        echo "published: $published"
        [ "$published" = "api 127.0.0.1:8080->8080, connectors 127.0.0.1:8081->8081" ] || { echo "FAIL: published ports"; fail=1; }

        # An authenticated call, from inside the API's container: the tokens in
        # .env reached it, and the configuration mounted at /etc/hearsay is the
        # one it serves.
        code=$(docker compose exec -T api wget -q -S -O /dev/null \
          --header 'Hearsay-Principal: operator' --header "Authorization: Bearer $operator" \
          --post-data '{"scope":"team"}' http://127.0.0.1:8080/v1/get_bundle 2>&1 | awk '/HTTP\//{print $2}' | tail -1)
        echo "get_bundle as operator: $code"
        [ "$code" = "200" ] || { echo "FAIL: get_bundle"; fail=1; }

        if [ "$fail" -ne 0 ]; then docker compose logs --no-color; exit 1; fi
        echo "compose smoke: ok"
      """])
      .stdout
  }

  """
  The local stack: Postgres with pgvector, and all four services in one process
  (ADR-0003's `hearsay all`).

  There is no file watcher. Restarting is the reload: stop `dagger up` and run
  it again, and the rebuild is a cached one.
  """
  dev(ws: Workspace!): Service! @up {
    runtime(ws)
      # The API: POST /v1/<call>, MCP at /mcp, and /healthz and /readyz.
      .withExposedPort(8080, description: "hearsay API (HTTP and MCP)")
      # The connectors service does listen: webhooks under /hooks/<source>, and
      # /healthz and /readyz (ADR-0008).
      .withExposedPort(8081, description: "hearsay connectors (webhooks and health)")
      .asService(useEntrypoint: true, args: ["all", "--log-level", "debug", "--log-format", "text"])
  }
}
